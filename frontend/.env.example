# URL base do backend Flask, usada pelo axios. O Flask libera esta origem
# via flask-cors no create_app().
VITE_API_BASE_URL=http://127.0.0.1:5000

# Origem do servidor Socket.IO. Mesmo host do REST: o Engine.IO e servido
# pelo proprio Flask, e a origem do front precisa estar em
# `cors_allowed_origins` (backend/extensions.py).
VITE_SOCKET_URL=http://127.0.0.1:5000

# Caminho do Engine.IO. O Flask-SocketIO atende em /socket.io por padrao.
VITE_SOCKET_PATH=/socket.io

# development | staging | production
VITE_APP_ENV=development
