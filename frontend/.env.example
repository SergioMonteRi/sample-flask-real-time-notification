# URL base usada pelo axios. Em dev usamos o proxy do Vite (/api),
# assim o backend Flask nao precisa habilitar CORS.
VITE_API_BASE_URL=/api

# Origem do servidor Socket.IO. Vazio = mesma origem do front, servida pelo
# proxy do Vite em dev — mesma razao do /api acima.
VITE_SOCKET_URL=

# Caminho do Engine.IO. O Flask-SocketIO atende em /socket.io por padrao.
VITE_SOCKET_PATH=/socket.io

# Alvo do proxy do Vite em desenvolvimento (HTTP e WebSocket).
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# development | staging | production
VITE_APP_ENV=development
